# Server
PORT=8080
NODE_ENV=development

# MongoDB (for auth & conversations)
MONGODB_URI=mongodb://localhost:27017/sql-agent

# MySQL / TiDB (for queryable data)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_PORT=3306
MYSQL_SSL=false

# TiDB Cloud (production)
TIDB_MYSQL_HOST=your-tidb-host
TIDB_MYSQL_USER=your-tidb-user
TIDB_MYSQL_PASSWORD=your-tidb-password
TIDB_MYSQL_PORT=4000
TIDB_MYSQL_SSL=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Google Gemini AI
GOOGLE_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Backblaze B2 (S3-compatible)
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET=your-bucket-name
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
